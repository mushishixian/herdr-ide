{
  "id": "root",
  "terminal_menu": "ide-term-menu",
  "cloned_from": {
    "name": "terminals",
    "version": "0.1.16"
  },
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [16, 18],
  "theme": { "light": "paper", "dark": "graphite" },
  "toast": "ide-toast",
  "padding": [6, 6],
  "gap": 8,
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "size": { "px": 38 },
      "window_drag": true,
      "content": { "mod": "terminals-bar-git" }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 8,
      "children": [
        {
          "id": "spaces-rail",
          "type": "column",
          "size": { "px": 210 },
          "min": 160,
          "max": 360,
          "background": "chrome",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": { "weight": 1 },
              "min": 120,
              "content": { "mod": "spaces-ide" }
            },
            {
              "id": "spaces-footer",
              "type": "block",
              "size": { "px": 69 },
              "content": {
                "mod": "workspace-chrome",
                "props": { "footer": true }
              }
            }
          ]
        },
        {
          "id": "sidebar",
          "type": "block",
          "hidden": false,
          "size": { "px": 300 },
          "min": 240,
          "max": 640,
          "content": { "mod": "ide-sidebar" }
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": { "content": { "mod": "ide-pane-header" }, "height": 38 },
              "background": "surface",
              "border": { "width": 1, "color": "border" },
              "focus": { "width": 1, "color": "accent" },
              "radius": 12,
              "gap": 8,
              "lone": true
            }
          }
        }
      ]
    }
  ]
}
