{
  "id": "root",
  "cloned_from": {
    "name": "terminals",
    "version": "0.1.16"
  },
  "type": "column",
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "content": {
        "mod": "terminals-bar-git"
      },
      "size": {
        "px": 38
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "spaces-rail",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-ide"
              },
              "size": {
                "weight": 1
              },
              "min": 120
            },
            {
              "id": "spaces-footer",
              "type": "block",
              "content": {
                "mod": "workspace-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 69
              }
            }
          ],
          "size": {
            "px": 210
          },
          "min": 160,
          "max": 360,
          "background": "chrome"
        },
        {
          "id": "sidebar",
          "type": "block",
          "content": {
            "mod": "ide-sidebar"
          },
          "size": {
            "px": 300
          },
          "min": 240,
          "max": 640
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "terminals-pane"
                },
                "height": 38
              },
              "background": "#17191c",
              "border": {
                "width": 1,
                "color": "#24272b"
              },
              "focus": {
                "width": 1,
                "color": "#33363b"
              },
              "radius": 12,
              "gap": 8,
              "lone": true
            }
          }
        }
      ],
      "gap": 8
    }
  ],
  "background": "#131619",
  "padding": [
    6,
    6
  ],
  "theme": "graphite",
  "colors": {
    "accent": "#3b82f6",
    "background": "#131619",
    "border": "#25282c",
    "chrome": "#17191c",
    "dim": "#8b8f95",
    "foreground": "#e8e9eb",
    "hover": "#ffffff0d",
    "muted": "#a9adb3",
    "popover": "#1d2024",
    "raised": "#202225",
    "selected": "#2a2f38",
    "selection": "#264f78",
    "surface": "#17191c",
    "terminal_foreground": "#e6e7e9"
  },
  "gap": 8,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    16,
    18
  ],
  "toast": "ide-toast"
}
