{
  "id": "root",
  "cloned_from": {
    "name": "terminals",
    "version": "0.1.16"
  },
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [16, 18],
  "theme": "graphite",
  "toast": "ide-toast",
  "background": "#131619",
  "padding": [6, 6],
  "gap": 8,
  "colors": {
    "accent": "#3b82f6",
    "background": "#131619",
    "surface": "#17191c",
    "chrome": "#17191c",
    "raised": "#202225",
    "popover": "#1d2024",
    "selected": "#2a2f38",
    "border": "#25282c",
    "dim": "#8b8f95",
    "muted": "#a9adb3",
    "foreground": "#e8e9eb",
    "hover": "#ffffff0d",
    "selection": "#264f78",
    "terminal_foreground": "#e6e7e9"
  },
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "size": { "px": 38 },
      "window_drag": true,
      "content": { "mod": "terminals-bar-git" }
    },
    {
      "id": "body",
      "type": "row",
      "gap": 8,
      "children": [
        {
          "id": "spaces-rail",
          "type": "column",
          "size": { "px": 210 },
          "min": 160,
          "max": 360,
          "background": "chrome",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": { "weight": 1 },
              "min": 120,
              "content": { "mod": "spaces-ide" }
            },
            {
              "id": "spaces-footer",
              "type": "block",
              "size": { "px": 69 },
              "content": {
                "mod": "workspace-chrome",
                "props": { "footer": true }
              }
            }
          ]
        },
        {
          "id": "sidebar",
          "type": "block",
          "hidden": false,
          "size": { "px": 300 },
          "min": 240,
          "max": 640,
          "content": { "mod": "ide-sidebar" }
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": { "content": { "mod": "terminals-pane" }, "height": 38 },
              "background": "#17191c",
              "border": { "width": 1, "color": "#24272b" },
              "focus": { "width": 1, "color": "#33363b" },
              "radius": 12,
              "gap": 8,
              "lone": true
            }
          }
        }
      ]
    }
  ]
}
